 import Agda.Utils.Monad
 import Agda.Utils.Null (empty)
 
 import Agda.Utils.Impossible
 
+-- | Record the identity of the import environment about to be loaded.
+-- The actual state is captured after scope checking has loaded every import.
+prepareFastImportCache :: String -> TCM ()
+prepareFastImportCache key = modifyFastImportPersistent $ \s ->
+  s { stPendingFastImportCacheKey = Strict.Just key }
+
+modifyFastImportPersistent :: (PersistentTCState -> PersistentTCState) -> TCM ()
+modifyFastImportPersistent f = modifyTC $ \s ->
+  s { stPersistentState = f $ stPersistentState s }
+
+-- | Restore only the imported portion of the previous pre-scope state.
+-- Local scope, local declarations, metas, interaction points and highlighting
+-- deliberately remain fresh. Dependency metadata is checked first and changed
+-- files are hashed, so an edited local module falls back to Agda's normal
+-- interface-loading path.
+restoreFastImportCache :: TCM Bool
+restoreFastImportCache = do
+  enabled <- (&&) <$> (optGHCiInteraction <$> commandLineOptions) <*> enableCaching
+  if not enabled then return False else do
+    persistent <- stPersistentState <$> getTC
+    case (stPendingFastImportCacheKey persistent, stPersistFastImportCache persistent) of
+      (Strict.Just key, Strict.Just cache) | key == ficKey cache -> do
+        valid <- validateDependencies cache
+        if valid then do
+          restoreImports $ ficPreScopeState cache
+          reportSLn "cache.imports" 5 "restored imported-module state"
+          return True
+        else do
+          modifyFastImportPersistent $ \s -> s { stPersistFastImportCache = Strict.Nothing }
+          reportSLn "cache.imports" 5 "discarded changed imported-module state"
+          return False
+      _ -> return False
+  where
+    validateDependencies cache
+      | length dependencies /= length interfaces = return False
+      | otherwise = do
+          immutable <- liftIO $ (== Just "1") <$> lookupEnv "AGDA_IMMUTABLE_IMPORTS"
+          if immutable then return True else and <$> zipWithM validate dependencies interfaces
+      where
+        dependencies = ficDependencies cache
+        interfaces = map (miInterface . snd) $ Map.toList $ stPreVisitedModules $ ficPreScopeState cache
+
+        validate (path, expectedFingerprint) interface = do
+          exists <- liftIO $ doesFileExist $ filePath path
+          if not exists then return False else do
+            fingerprint <- liftIO $ dependencyFingerprint path
+            if fingerprint == expectedFingerprint
+              then return True
+              else do
+                -- Metadata changed: hash the source before invalidating. This
+                -- keeps correctness while making the normal reload path a
+                -- cheap stat call per immutable browser dependency.
+                sourceHash <- liftIO $ hashTextFile path
+                return $ sourceHash == iSourceHash interface
+
+    dependencyFingerprint path = do
+      modified <- getModificationTime $ filePath path
+      size <- getFileSize $ filePath path
+      return $ hashString $ show modified ++ ":" ++ show size
+
+    restoreImports cached = modifyTC $ \s ->
+      let current = stPreScopeState s
+          visited = stPreVisitedModules cached
+          interfaces = map (miInterface . snd) $ Map.toList visited
+          pre = current
+            { stPreImports                   = stPreImports cached
+            , stPreImportedModules           = stPreImportedModules cached
+            , stPreImportedModulesTransitive = stPreImportedModulesTransitive cached
+            , stPreModuleToSourceId          = stPreModuleToSourceId cached
+            , stPreVisitedModules            = visited
+            , stPrePatternSynImports         = stPrePatternSynImports cached
+            , stPreImportedBuiltins          = stPreImportedBuiltins cached
+            , stPreImportedDisplayForms      = stPreImportedDisplayForms cached
+            , stPreImportedUserWarnings      = stPreImportedUserWarnings cached
+            , stPreImportedPartialDefs       = stPreImportedPartialDefs cached
+            , stPreImportedMetaStore         = stPreImportedMetaStore cached
+            }
+          post0 = stPostScopeState s
+          post = post0
+            { stPostTCWarnings   = Set.unions $ map iWarnings interfaces
+            , stPostOpaqueBlocks = Map.unions $ map iOpaqueBlocks interfaces
+            , stPostOpaqueIds    = Map.unions $ map iOpaqueNames interfaces
+            }
+      in s { stPreScopeState = pre, stPostScopeState = post }
+
+-- | Save the import baseline after scope checking, before checking any local
+-- declarations. This is the state a subsequent edit needs to start from.
+saveFastImportCache :: [(AbsolutePath, Hash)] -> TCM ()
+saveFastImportCache dependencies = do
+  enabled <- (&&) <$> (optGHCiInteraction <$> commandLineOptions) <*> enableCaching
+  when enabled $ do
+    state <- getTC
+    case stPendingFastImportCacheKey $ stPersistentState state of
+      Strict.Nothing -> return ()
+      Strict.Just key -> modifyFastImportPersistent $ \persistent -> persistent
+        { stPersistFastImportCache = Strict.Just $ FastImportCache key (stPreScopeState state) dependencies }
+
