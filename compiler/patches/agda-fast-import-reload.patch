+-- | Stable identity for the imported environment of an interactive load.
+-- Import directives affect the freshly rebuilt local scope, but the imported
+-- signature itself depends only on which top-level modules are loaded and on
+-- the effective command/file options. Dependency contents are validated by
+-- 'restoreFastImportCache' before this key is accepted.
+fastImportCacheKey :: AbsolutePath -> [String] -> Bool -> Mode -> CommandLineOptions -> Imp.Source -> String
+fastImportCacheKey fp argv unsolvedOK mode effectiveOptions src = show
+  ( filePath fp
+  , argv
+  , unsolvedOK
+  , case mode of
+      ScopeCheck -> "scope"
+      TypeCheck  -> "type"
+  , effectiveOptions
+  , prettyShow $ Imp.srcModuleName src
+  , map prettyShow $ C.modPragmas $ Imp.srcModule src
+  , foldDecl importedModule $ C.modDecls $ Imp.srcModule src
+  )
+  where
+    importedModule = \case
+      C.Import _ name _ _ _ -> [prettyShow name]
+      _                     -> []
+
